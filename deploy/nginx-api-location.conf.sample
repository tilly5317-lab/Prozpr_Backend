# Merge this `location /api/` block into the `server { ... }` that serves 43.205.235.185 (or your API host).
# Then: `sudo nginx -t && sudo systemctl reload nginx`
#
# Why: Browsers treat failed OPTIONS (e.g. 502 when uvicorn is down) as a CORS failure with
# "No 'Access-Control-Allow-Origin' header". Answering OPTIONS at the edge with 204 + CORS
# headers lets preflight succeed; the follow-up GET/POST still needs the app running.
#
# nginx `if` is limited; this pattern is the common CORS preflight workaround.

location /api/ {
    if ($request_method = OPTIONS) {
        add_header Access-Control-Allow-Origin $http_origin always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,Accept,Origin,Cookie" always;
        add_header Access-Control-Max-Age 86400 always;
        return 204;
    }

    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Credentials;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Access-Control-Expose-Headers;
    proxy_hide_header Access-Control-Max-Age;

    add_header Access-Control-Allow-Origin $http_origin always;
    add_header Access-Control-Allow-Credentials true always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,Accept,Origin,Cookie" always;

    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # 504 Gateway Time-out fix. nginx's default proxy_read_timeout is 60s, but a
    # chat turn (e.g. "best performing mutual funds" → market_commentary web-search
    # LLM chain) is allowed up to _FLOW_TIMEOUT_S = 180s in the backend
    # (app/domains/ai_engine/services/brain.py). With the default, nginx cuts the
    # connection at 60s and returns 504 while the app is still generating the reply.
    # Keep these ABOVE the backend flow timeout so the backend's own timeout/fallback
    # is what the client sees, never nginx's. Update both if _FLOW_TIMEOUT_S changes.
    proxy_connect_timeout 75s;
    proxy_send_timeout    200s;
    proxy_read_timeout    200s;
}
