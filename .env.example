# =============================================================================
# Database — use AWS RDS PostgreSQL in production (driver: asyncpg).
# Local SQLite files (e.g. wealth_agent.db) are rejected unless ALLOW_SQLITE=true.
# =============================================================================

# --- Option A: single URL (typical for RDS) ---
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@your-db.region.rds.amazonaws.com:5432/dbname?ssl=require

# --- Option B: discrete variables (password may need URL-encoding in Option A) ---
# POSTGRES_HOST=your-db.region.rds.amazonaws.com
# POSTGRES_PORT=5432
# POSTGRES_USER=app_user
# POSTGRES_PASSWORD=secret
# POSTGRES_DB=prozpr

# --- Local SQLite only (development; not for production) ---
# ALLOW_SQLITE=true
# DATABASE_URL=sqlite+aiosqlite:///./wealth_agent.db

# After deploy, apply migrations on RDS:
#   alembic upgrade head

# Faster uvicorn startup against RDS: skip create_all + startup DDL (schema must exist).
# SKIP_STARTUP_DB_DDL=true

# =============================================================================
# LLM — Anthropic. Invalid keys return 401.
# Each module has its own env var. Unset module vars fall back to ANTHROPIC_API_KEY.
# Use module-specific keys to (a) attribute spend per module on the Anthropic
# dashboard and (b) isolate rate-limit blast radius across features.
# =============================================================================
# ANTHROPIC_API_KEY=sk-ant-api03-...                # shared fallback
# INTENT_CLASSIFIER_API_KEY=sk-ant-api03-...        # intent classifier
# RISK_PROFILING_API_KEY=sk-ant-api03-...           # risk profiling
# ASSET_ALLOCATION_API_KEY=sk-ant-api03-...         # AA chat + AA pipeline rationale
# REBALANCING_API_KEY=sk-ant-api03-...              # rebalancing chat
# PORTFOLIO_QUERY_API_KEY=sk-ant-api03-...          # portfolio Q&A
# MARKET_COMMENTARY_API_KEY=sk-ant-api03-...        # market commentary
# GENERAL_CHAT_API_KEY=sk-ant-api03-...             # general chat + chat titles
# ANSWER_FORMATTER_API_KEY=sk-ant-api03-...         # shared answer formatter (AA + rebalancing + goal planning)
# ANTHROPIC_GOAL_PLANNING_API_KEY=sk-ant-api03-...  # goal planning (cashflow summarizer)

# ── Issue-report support mail (Zoho) + Google Sheet register ─────────
# Defaults shown; only SMTP_PASSWORD is required for sending. When unset,
# issue emails are skipped (reports still land in the Google Sheet).
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=support@prozpr.com
# Zoho app-specific password (Zoho Account -> Security -> App Passwords)
SMTP_PASSWORD=
# Where issue-report notifications are delivered
SUPPORT_EMAIL_TO=support@prozpr.com
# Google Sheet issue register (Apps Script web app). This is the SOLE register —
# report-issue returns 503 if the webhook is unset or unreachable.
ISSUE_SHEET_WEBHOOK_URL=
ISSUE_SHEET_TOKEN=

# ── New-signup team notification (no admin dashboard) ────────────────
# When a user completes onboarding (with name + email), we ping the team and/or
# log the user. Both channels are best-effort and optional — an unset webhook is
# skipped and the request still succeeds. Set at least SLACK_SIGNUP_WEBHOOK_URL.
#
# Slack Incoming Webhook (Slack -> Apps -> Incoming Webhooks -> Add to a channel
# like #signups). The channel doubles as a searchable running log of signups.
SLACK_SIGNUP_WEBHOOK_URL=
# Optional: a separate Google Sheet ("New Signups") via an Apps Script web app
# (same pattern as ISSUE_SHEET_WEBHOOK_URL) for a sortable all-users-in-one-place
# table. SIGNUP_SHEET_TOKEN is the shared secret the script checks.
SIGNUP_SHEET_WEBHOOK_URL=
SIGNUP_SHEET_TOKEN=
