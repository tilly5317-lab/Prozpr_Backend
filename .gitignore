# Python — never commit bytecode or local venv (binary .pyc merge conflicts; huge diffs).
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyc
.effo
# Virtual environment (must not be tracked)
.venv/
.venv-mac/
venv/
env/
.env/

# Environment variables / secrets (`.env.example` stays tracked)
.env
.env.*
!.env.example
*.pem

# Local SQLite / tooling
*.sqlite
*.sqlite3

# IDE / Editor
.vscode/
.idea/
.obsidian/
*.swp
*.swo
*~

# Linter / Formatter caches
.ruff_cache/
.mypy_cache/
.pyright/

# Distribution / Packaging
dist/
build/
*.egg-info/
*.egg

# SQLite databases
*.db

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log

# Pytest — ignore CACHES/COVERAGE only. Test CODE (test_*.py, conftest.py) IS
# version-controlled on purpose: it ships with the source it protects, is reviewed
# in the same PR, and can run in CI. Test DATA/fixtures/outputs stay out of git via
# the type rules above (*.csv, *.db, __pycache__) and the dev-harness dirs below —
# NOT by ignoring whole tests/ directories (that blocked the test code itself).
.pytest_cache/
htmlcov/
.coverage

# Jupyter
.ipynb_checkpoints/

# Large data files (CSV)
*.csv
!AI_Agents/Reference_docs/Prozpr_fund_ranking.csv
!AI_Agents/Reference_docs/prozpr_fund_ranking_may_2026.csv

# Alembic auto-generated (keep versions/, ignore stamps)
# alembic/versions/ is tracked

# Superpowers (local only)
docs/superpowers/
**/docs/superpowers/
**/.claude/agents/
**/.claude/hooks/

# Shared .claude/commands — ignore all except the backend-root refresh-context command
**/.claude/commands/
!/.claude/
!/.claude/commands/
/.claude/commands/*
!/.claude/commands/refresh-context.md

# Agent audit runs (local test harness only)
Agent_audit/

# Cache files
AI_Agents/src/market_commentary/market_commentary_latest.json
AI_Agents/src/market_commentary/market_commentary_latest.md

# Dev-only agent scratch / experiment / eval / simulation harnesses + their data.
# These are LOCAL exploration dirs (capital-T "Testing", "Master_testing", eval,
# sim), NOT the unit-test suite — the unit tests in lowercase tests/ dirs are
# tracked. Keep these out of version control.
/AI_Agents/src/goal_based_allocation/Testing
/AI_Agents/src/goal_based_allocation_pydantic/Testing
/AI_Agents/src/goal_based_allocation_pydantic/references
/AI_Agents/src/goal_based_allocation_pydantic/Master_testing
/AI_Agents/src/goal_based_allocation_pydantic/simulation_website/goal_allocation_explorer.html
/AI_Agents/src/.claude/skills
/AI_Agents/src/*/Testing/
/AI_Agents/src/chat_eval
/AI_Agents/src/asset_allocation_pydantic/Master_testing
/AI_Agents/src/practical_asset_allocation/Master_testing
/AI_Agents/src/additional_investment/Master_testing
/AI_Agents/lifecycle_sim_testing

# Dev-only scripts (seed helpers, one-offs) — keep local, do not push
scripts/

# Artifact sources: generators, their captured data, and the HTML published to
